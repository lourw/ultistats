<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="mx-auto max-w-md space-y-8">
    <.header>
      Confirm your details
      <:subtitle>
        Joining <span class="font-semibold">{@team.name}</span>. Update anything below before claiming this player.
      </:subtitle>
    </.header>

    <.form
      for={@form}
      action={~p"/join/#{@token}/claim/#{@membership.id}"}
      method="post"
      class="flex flex-col gap-3"
    >
      <div class="rounded-lg border-2 border-base-300 bg-base-100 px-4 py-3">
        <p class="text-xs uppercase tracking-wide text-base-content/60">Claiming</p>
        <p class="text-base font-semibold text-base-content">
          {User.display_name(@membership.user)}
        </p>
        <p class="mt-1 text-sm text-base-content/70 tabular-nums">
          for {@team.name}
          <span class="text-base-content/40">·</span>
          {@team_stats.total_players} {pluralize_players(@team_stats.total_players)}
          <span class="text-base-content/40">·</span>
          {@team_stats.male_matching}M / {@team_stats.female_matching}F
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <div class="space-y-1">
          <label for="member_first_name" class="block text-sm font-medium text-base-content">
            First name
          </label>
          <.input field={@form[:first_name]} type="text" autocomplete="given-name" />
        </div>
        <div class="space-y-1">
          <label for="member_last_name" class="block text-sm font-medium text-base-content">
            Last name
          </label>
          <.input field={@form[:last_name]} type="text" autocomplete="family-name" />
        </div>
      </div>

      <div class="space-y-1">
        <p class="block text-sm font-medium text-base-content">Gender</p>
        <.gender_radio field={@form[:gender_role]} />
        <p
          :for={msg <- Enum.map(@form[:gender_role].errors, &translate_error(&1))}
          class="mt-1 text-xs text-error"
        >
          {msg}
        </p>
      </div>

      <div class="space-y-1">
        <p class="block text-sm font-medium text-base-content">Position</p>
        <.position_radio field={@form[:position]} />
        <p
          :for={msg <- Enum.map(@form[:position].errors, &translate_error(&1))}
          class="mt-1 text-xs text-error"
        >
          {msg}
        </p>
      </div>

      <div class="space-y-1">
        <label for="member_jersey_number" class="block text-sm font-medium text-base-content">
          Jersey number
        </label>
        <.input
          field={@form[:jersey_number]}
          type="text"
          inputmode="numeric"
          maxlength="4"
        />
      </div>

      <footer class="flex items-center gap-3 pt-2">
        <.button type="submit" variant="primary" phx-disable-with="Claiming...">
          Confirm and join
        </.button>
        <.button href={~p"/join/#{@token}"}>Cancel</.button>
      </footer>
    </.form>
  </div>
</Layouts.app>
