<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="mx-auto max-w-md space-y-8">
    <.header>
      Join {@team.name}
      <:subtitle>
        Log in or register to continue — you'll come back here automatically.
      </:subtitle>
    </.header>

    <.joining_card team={@team} team_stats={@team_stats} />

    <div class="grid grid-cols-2 gap-3">
      <.button href={~p"/users/log-in"} variant="primary">
        Log in
      </.button>
      <.button href={~p"/users/register"}>
        Register
      </.button>
    </div>
  </div>
</Layouts.app>
