<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="flex flex-col gap-12 py-6">
    <section class="flex flex-col items-center text-center gap-5">
      <span class="inline-flex items-center gap-1.5 rounded-full bg-primary/10 text-primary text-[11px] font-semibold uppercase tracking-wide px-3 py-1">
        <.icon name="hero-bolt-solid" class="size-3.5" /> Live from the sideline
      </span>

      <h1 class="text-4xl sm:text-5xl font-bold leading-tight tracking-tight">
        Track every point.<br />
        <span class="text-primary">Coach with the data.</span>
      </h1>

      <p class="max-w-md text-base text-base-content/70 leading-relaxed">
        A mobile-first ultimate frisbee stat tracker for the sideline. Tap pulls, lines, goals, blocks, turns — and see your team's story take shape in real time.
      </p>

      <div class="flex flex-wrap items-center justify-center gap-2 mt-2">
        <.link
          navigate={~p"/users/log-in"}
          class="min-h-11 inline-flex items-center justify-center px-5 rounded-md text-sm font-semibold bg-primary text-primary-content active:bg-primary/80 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
        >
          Log in
        </.link>
        <.link
          navigate={~p"/users/register"}
          class="min-h-11 inline-flex items-center justify-center px-5 rounded-md text-sm font-semibold border border-base-300 text-base-content active:bg-base-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
        >
          Create account
        </.link>
      </div>
    </section>

    <section class="grid grid-cols-1 sm:grid-cols-3 gap-3">
      <article class="rounded-md border border-base-200 p-4 flex flex-col gap-2">
        <span class="inline-flex items-center justify-center size-9 rounded-md bg-success/10 text-success">
          <.icon name="hero-users-solid" class="size-5" />
        </span>
        <h2 class="font-semibold text-sm">Set your line</h2>
        <p class="text-xs text-base-content/70 leading-relaxed">
          Pick O- or D-line in seconds with presets, ratio guards, and one-tap player chips.
        </p>
      </article>

      <article class="rounded-md border border-base-200 p-4 flex flex-col gap-2">
        <span class="inline-flex items-center justify-center size-9 rounded-md bg-warning/10 text-warning">
          <.icon name="hero-cursor-arrow-rays-solid" class="size-5" />
        </span>
        <h2 class="font-semibold text-sm">Tap the action</h2>
        <p class="text-xs text-base-content/70 leading-relaxed">
          Catches, drops, blocks, throwaways, goals — every event captured by tapping the player.
        </p>
      </article>

      <article class="rounded-md border border-base-200 p-4 flex flex-col gap-2">
        <span class="inline-flex items-center justify-center size-9 rounded-md bg-info/10 text-info">
          <.icon name="hero-chart-bar-solid" class="size-5" />
        </span>
        <h2 class="font-semibold text-sm">See the story</h2>
        <p class="text-xs text-base-content/70 leading-relaxed">
          Per-game summary, timeline, and per-player stats — for film review and rotation calls.
        </p>
      </article>
    </section>
  </div>
</Layouts.app>
