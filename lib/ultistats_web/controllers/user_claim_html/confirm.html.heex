<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="mx-auto max-w-sm space-y-6">
    <.header>
      Claim profile
      <:subtitle>
        Confirm linking <span class="font-semibold">{User.display_name(@stub)}</span>
        to your account ({@current_user.email}). The stub's team
        memberships and recorded events will move onto your account.
      </:subtitle>
    </.header>

    <.form for={%{}} action={~p"/claim/#{@token}"} method="post" class="space-y-3">
      <.button class="btn btn-primary w-full">
        Claim {User.display_name(@stub)}'s profile
      </.button>
      <.link href={~p"/"} class="btn btn-ghost w-full">
        Cancel
      </.link>
    </.form>
  </div>
</Layouts.app>
