<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="text-center">
    <.header>
      Profile
      <:subtitle>
        Signed in as {@current_scope.user.email}
      </:subtitle>
    </.header>
  </div>

  <div
    role="tablist"
    aria-label="Settings sections"
    class="mt-4 flex gap-6 border-b border-base-200"
  >
    <.link
      href={~p"/users/settings?tab=profile"}
      role="tab"
      aria-selected={to_string(@active_tab == :profile)}
      class={settings_tab_classes(@active_tab == :profile)}
    >
      Profile
    </.link>
    <.link
      href={~p"/users/settings?tab=preferences"}
      role="tab"
      aria-selected={to_string(@active_tab == :preferences)}
      class={settings_tab_classes(@active_tab == :preferences)}
    >
      Preferences
    </.link>
    <.link
      href={~p"/users/settings?tab=auth"}
      role="tab"
      aria-selected={to_string(@active_tab == :auth)}
      class={settings_tab_classes(@active_tab == :auth)}
    >
      Auth
    </.link>
  </div>

  <section
    :if={@active_tab == :preferences}
    class="mt-4"
    aria-labelledby="tab-preferences"
  >
    <.form
      :let={f}
      for={@settings_changeset}
      action={~p"/users/settings?tab=preferences"}
      id="update_settings"
      class="flex flex-col gap-3"
    >
      <input type="hidden" name="action" value="update_settings" />

      <fieldset class="space-y-1">
        <legend class="block text-sm font-medium text-base-content">
          Default in-point sort
        </legend>
        <p class="text-xs text-base-content/70">
          New games start the on-field player list sorted this way. You can still
          change it per-game from the in-point sort menu.
        </p>
        <div class="inline-flex flex-wrap items-center gap-2 mt-1" role="radiogroup">
          <label
            :for={{label, value} <- [{"Jersey #", :jersey}, {"Name", :name}]}
            class={[
              "h-9 inline-flex items-center gap-2 px-3 rounded-md text-sm font-medium",
              "border border-base-300 bg-base-100 text-base-content cursor-pointer select-none",
              "active:bg-base-200",
              "has-[:checked]:bg-primary/10 has-[:checked]:border-primary",
              "focus-within:outline-2 focus-within:outline-offset-2 focus-within:outline-primary"
            ]}
          >
            <input
              type="radio"
              name={f[:default_line_sort].name}
              id={"#{f[:default_line_sort].id}_#{value}"}
              value={value}
              checked={
                f[:default_line_sort].value == value or
                  f[:default_line_sort].value == Atom.to_string(value)
              }
              class="accent-primary size-4 shrink-0"
            />
            <span>{label}</span>
          </label>
        </div>
      </fieldset>

      <fieldset class="space-y-1">
        <legend class="block text-sm font-medium text-base-content">
          Default line picker sort
        </legend>
        <p class="text-xs text-base-content/70">
          New games start the between-points line picker sorted this way.
        </p>
        <div class="inline-flex flex-wrap items-center gap-2 mt-1" role="radiogroup">
          <label
            :for={
              {label, value} <- [{"Jersey #", :jersey}, {"Name", :name}, {"Playtime", :points}]
            }
            class={[
              "h-9 inline-flex items-center gap-2 px-3 rounded-md text-sm font-medium",
              "border border-base-300 bg-base-100 text-base-content cursor-pointer select-none",
              "active:bg-base-200",
              "has-[:checked]:bg-primary/10 has-[:checked]:border-primary",
              "focus-within:outline-2 focus-within:outline-offset-2 focus-within:outline-primary"
            ]}
          >
            <input
              type="radio"
              name={f[:default_line_picker_sort].name}
              id={"#{f[:default_line_picker_sort].id}_#{value}"}
              value={value}
              checked={
                f[:default_line_picker_sort].value == value or
                  f[:default_line_picker_sort].value == Atom.to_string(value)
              }
              class="accent-primary size-4 shrink-0"
            />
            <span>{label}</span>
          </label>
        </div>
      </fieldset>

      <footer class="mt-4 pt-4 border-t border-base-300 flex items-center gap-3">
        <.button variant="primary" phx-disable-with="Saving...">Save preferences</.button>
      </footer>
    </.form>
  </section>

  <section :if={@active_tab == :profile} class="mt-4" aria-labelledby="tab-profile">
    <.form
      :let={f}
      for={@profile_changeset}
      action={~p"/users/settings"}
      id="update_profile"
      class="flex flex-col gap-3"
    >
      <input type="hidden" name="action" value="update_profile" />

      <.input field={f[:first_name]} type="text" label="First name" maxlength="40" required />
      <.input field={f[:last_name]} type="text" label="Last name" maxlength="40" required />
      <.input
        field={f[:jersey_number]}
        type="text"
        label="Default jersey number"
        maxlength="4"
        inputmode="numeric"
      />

      <div class="flex flex-col gap-1">
        <p class="block text-sm font-medium text-base-content">Gender</p>
        <.gender_radio field={f[:gender_role]} />
      </div>

      <div class="flex flex-col gap-1">
        <p class="block text-sm font-medium text-base-content">Position</p>
        <.position_radio field={f[:position]} />
      </div>

      <footer class="mt-4 pt-4 border-t border-base-300 flex items-center gap-3">
        <.button variant="primary" phx-disable-with="Saving...">Save profile</.button>
      </footer>
    </.form>
  </section>

  <section :if={@active_tab == :auth} class="mt-4 flex flex-col gap-4" aria-labelledby="tab-auth">
    <.form
      :let={f}
      for={@email_changeset}
      action={~p"/users/settings?tab=auth"}
      id="update_email"
      class="flex flex-col gap-3"
    >
      <input type="hidden" name="action" value="update_email" />

      <.input
        field={f[:email]}
        type="email"
        label="Email"
        autocomplete="username"
        spellcheck="false"
        required
      />

      <.button variant="primary" phx-disable-with="Changing..." class="self-start">
        Change Email
      </.button>
    </.form>

    <div class="divider my-0" />

    <.form
      :let={f}
      for={@password_changeset}
      action={~p"/users/settings?tab=auth"}
      id="update_password"
      class="flex flex-col gap-3"
    >
      <input type="hidden" name="action" value="update_password" />

      <.input
        field={f[:password]}
        type="password"
        label="New password"
        autocomplete="new-password"
        spellcheck="false"
        required
      />
      <.input
        field={f[:password_confirmation]}
        type="password"
        label="Confirm new password"
        autocomplete="new-password"
        spellcheck="false"
        required
      />

      <.button variant="primary" phx-disable-with="Changing..." class="self-start">
        Save Password
      </.button>
    </.form>

    <section class="pt-4 border-t border-base-200 flex flex-col gap-2">
      <h2 class="text-sm font-semibold text-base-content/70 uppercase tracking-wide">
        Sign out
      </h2>
      <.link
        href={~p"/users/log-out"}
        method="delete"
        class="self-start inline-flex items-center justify-center gap-2 min-h-11 px-4 py-2 rounded-md text-sm font-semibold bg-error text-error-content active:bg-error/80 transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
      >
        <.icon name="hero-arrow-right-start-on-rectangle" class="size-5" /> Log out
      </.link>
    </section>
  </section>
</Layouts.app>
